{
  "name": "social-api-manager",
  "version": "1.1.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npm run frontend:build",
    "frontend:dev": "vite --config frontend/vite.config.js",
    "frontend:build": "vite build --config frontend/vite.config.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "test:coverage": "jest --runInBand --coverage",
    "test:all": "npm test && npm run test:components",
    "test:components": "vitest run --config frontend/vitest.config.js",
    "security:preflight": "node scripts/security-preflight.js",
    "security:migrate-encrypted-secrets": "node scripts/migrate-encrypted-secrets.js",
    "zernio:webhook:register": "node scripts/register-zernio-webhook.js",
    "db:migrate:security:local": "node scripts/apply-security-migration-local.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.js",
      "src/middleware/**/*.js",
      "src/services/mediaToken.js",
      "src/services/tokenCrypto.js",
      "src/services/totp.js",
      "src/services/commentsService.js",
      "src/config/**/*.js",
      "src/http/errorHandler.js",
      "src/infra/http/**/*.js",
      "src/domain/posts/errors.js",
      "src/repositories/usersRepository.js",
      "src/repositories/postsRepository.js",
      "src/repositories/credentialsRepository.js",
      "src/repositories/logsRepository.js",
      "src/routes/drafts.js",
      "src/routes/posts.js",
      "src/routes/auth.js",
      "src/routes/admin.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary"
    ],
    "coverageThreshold": {}
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.0",
    "@google/genai": "^2.10.0",
    "@google/generative-ai": "^0.24.1",
    "@vercel/blob": "^2.4.1",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "heic-convert": "^2.1.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.1",
    "openai": "^6.45.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.2",
    "undici": "^6.28.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "jest": "^30.4.2",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.25",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "vercel": "^54.14.5",
    "vite": "^7.0.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
