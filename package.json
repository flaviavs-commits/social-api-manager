{
  "name": "social-api-manager",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "frontend:dev": "vite --config frontend/vite.config.js",
    "frontend:build": "vite build --config frontend/vite.config.js",
    "test": "set NODE_ENV=test&& jest --runInBand",
    "test:coverage": "set NODE_ENV=test&& jest --runInBand --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.js",
      "src/middleware/**/*.js",
      "src/services/mediaToken.js",
      "src/services/tokenCrypto.js",
      "src/services/totp.js",
      "src/repositories/usersRepository.js",
      "src/repositories/postsRepository.js",
      "src/repositories/credentialsRepository.js",
      "src/repositories/logsRepository.js",
      "src/routes/drafts.js",
      "src/routes/posts.js",
      "src/routes/auth.js",
      "src/routes/admin.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary"
    ],
    "coverageThreshold": {}
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.0",
    "@google/genai": "^2.10.0",
    "@google/generative-ai": "^0.24.1",
    "@vercel/blob": "^2.4.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.1",
    "openai": "^6.45.0",
    "pg": "^8.21.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "vite": "^7.0.6",
    "supertest": "^7.2.2",
    "vercel": "^54.14.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
