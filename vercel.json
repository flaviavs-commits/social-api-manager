{
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/tiktok-developers-site-verification=OmQtGQblarLSaeh7GBz95OjoP0bC1vI4.txt",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/process-posts", "schedule": "0 9 * * *" },
    { "path": "/api/cron/renew-tokens", "schedule": "0 10 * * *" }
  ]
}
