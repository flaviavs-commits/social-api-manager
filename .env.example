# =============================================================================
# MeuEcooMedia — exemplo de configuracao
#
# Copie para .env e preencha. O .env e ignorado pelo git; ESTE arquivo e
# versionado e NAO deve conter nenhum valor real — so o nome da variavel,
# o que ela faz e como obte-la.
#
#   cp .env.example .env
#
# Ou use o menu: python start_app.py  ->  Configurar
# =============================================================================


# -----------------------------------------------------------------------------
# OBRIGATORIAS — a aplicacao nao sobe ou quebra em runtime sem elas
# -----------------------------------------------------------------------------

# String de conexao do PostgreSQL.
DATABASE_URL=

# Segredo usado para assinar o token de sessao (src/utils/authToken.js).
# Gere um valor longo e aleatorio:  openssl rand -hex 32
AUTH_TOKEN_SECRET=

# Segredo de sessao. Gere separado do AUTH_TOKEN_SECRET.
SESSION_SECRET=

# Chave AES-256-GCM que cifra access_token/refresh_token das redes sociais
# antes de gravar no banco (src/services/tokenCrypto.js).
# Precisa ser exatamente 32 bytes em hexadecimal:  openssl rand -hex 32
#
# ATENCAO: trocar esta chave torna ilegiveis todos os tokens ja cifrados com
# a anterior (formato "enc:v1:"). Os usuarios precisariam reconectar as contas.
TOKEN_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# URLs E REDE
# -----------------------------------------------------------------------------

# Porta do servidor. Default: 3000
PORT=3000

# URL publica do backend, usada para montar callbacks de OAuth.
# Default: http://localhost:3000
BASE_URL=

# URL publica do frontend. Usada em redirects de login e reset de senha.
FRONTEND_URL=

# Origem permitida no CORS. Sem valor, cai para "*" — defina em producao.
FRONTEND_ORIGIN=

# IP de bind do servidor. Default: 0.0.0.0
# Util para acessar o app de outro aparelho na mesma rede local.
LAN_IP=


# -----------------------------------------------------------------------------
# META — Facebook e Instagram
# App em https://developers.facebook.com/apps
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=


# -----------------------------------------------------------------------------
# GOOGLE — login e YouTube
# Credenciais em https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------

# OAuth do YouTube (publicacao de video).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Redirect do "entrar com Google" — separado do fluxo do YouTube.
GOOGLE_LOGIN_REDIRECT_URI=

# API key do Google usada pelo frontend (Picker/Drive).
GOOGLE_API_KEY=


# -----------------------------------------------------------------------------
# TIKTOK
# App em https://developers.tiktok.com
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Modo de revisao do TikTok: libera um caminho de acesso sem senha para o
# revisor da plataforma avaliar o app.
#
# ATENCAO: mantenha VAZIO fora do periodo de revisao. Com valor, cria um
# login automatico. Ver Fase 4 do plano de migracao — este modo precisa de
# prazo de expiracao ou remocao.
TIKTOK_REVIEW_MODE=
TIKTOK_REVIEW_USER_ID=


# -----------------------------------------------------------------------------
# IA — geracao de conteudo
# Opcionais: sem chave, o provedor correspondente responde 503 com mensagem
# pedindo que o usuario configure a propria chave no perfil.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Limite diario de geracoes no modo demonstracao. Vazio = sem limite.
AI_DEMO_LIMITE_DIA=


# -----------------------------------------------------------------------------
# ARMAZENAMENTO DE MIDIA
# -----------------------------------------------------------------------------

# Token do Vercel Blob. O SDK @vercel/blob le esta variavel automaticamente,
# por isso ela nao aparece como process.env no codigo.
BLOB_READ_WRITE_TOKEN=


# -----------------------------------------------------------------------------
# NOTIFICACOES
# -----------------------------------------------------------------------------

# Web Push (VAPID). Gere o par com:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail de contato exigido pelo padrao VAPID. Default: admin@app.local
VAPID_EMAIL=

# Envio de e-mail transacional (reset de senha) via Gmail.
# GMAIL_APP_PASSWORD e uma "senha de app", nao a senha da conta:
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=


# -----------------------------------------------------------------------------
# AGENDAMENTO
# -----------------------------------------------------------------------------

# Segredo que autentica as chamadas do cron da Vercel nas rotas de publicacao
# agendada. Sem valor, a rota rejeita a chamada.
CRON_SECRET=
